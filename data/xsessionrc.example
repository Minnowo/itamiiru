# For X sessions started by /etc/X11/Xsession (Debian and Ubuntu with
# lightdm, gdm on X11, ...; XFCE, MATE, Cinnamon). Append to ~/.xsessionrc,
# then log out and back in. Wayland and systemd-based sessions use
# itamiiru-env.conf.example instead.
#
# Xsession runs with `set -e`: a failing line here stops the login, so
# every command must be guarded.

# GTK 3 and GTK 4 apps send file dialogs to the portal, and so to itamiiru.
export GTK_USE_PORTAL=1
export GDK_DEBUG=portals
# Apps started by D-Bus activation get the activation environment, not
# this session's, so copy the two variables there as well.
if command -v dbus-update-activation-environment > /dev/null 2>&1; then
  dbus-update-activation-environment --systemd GTK_USE_PORTAL GDK_DEBUG || true
fi
# Qt apps: only with the xdgdesktopportal platform theme installed, and it
# replaces qt5ct/qt6ct:
# export QT_QPA_PLATFORMTHEME=xdgdesktopportal
